{
  "name": "oau-bat-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "reporting:dry-run": "npx --yes tsx scripts/reporting_desk_dry_run.ts",
    "reporting:bundle": "npx --yes tsx scripts/export_reporting_bundle.ts",
    "pilot:lock": "npx --yes tsx scripts/pilot_verification_lock.ts",
    "sync:mobile-codes": "node scripts/sync_mobile_code_lists.mjs",
    "verify:supabase": "node scripts/verify_supabase_schema.mjs",
    "verify:supabase:checklist": "node scripts/verify_supabase_schema.mjs --checklist-only",
    "s2:preflight": "python scripts/s2_migration_preflight.py",
    "qc:rasters": "python scripts/national_raster_qc.py",
    "qc:rasters:checklist": "python scripts/national_raster_qc.py --checklist-only",
    "import:pressure-staging": "python scripts/import_pressure_layers.py",
    "import:sbc-staging": "python scripts/import_sbc_staging.py",
    "export:steering-docx": "python scripts/export_steering_docx.py",
    "qc:ceid": "python scripts/ceid_join_qc.py",
    "qc:summary": "python scripts/qc_programme_summary.py",
    "qc:refresh": "python scripts/pressure_layer_qc.py && python scripts/intervention_spatial_qc.py && python scripts/national_raster_qc.py && npm run qc:summary"
  },
  "dependencies": {
    "framer-motion": "^11.2.10",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.383.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
